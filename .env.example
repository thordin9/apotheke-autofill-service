# Example settings for apotheke-autofill-service. Copy what you need into your
# shell, .env.local or a docker --env-file; every variable is optional. Docs: README.md
# ("Configuration") and docs/api-v1.md.

# --- Service -----------------------------------------------------------------
# echo | ollama | clip
BACKEND=echo
# empty = no auth; set = Bearer token on all but /healthz
AUTOFILL_TOKEN=
# 10 MiB
MAX_IMAGE_BYTES=10485760
# 45 in the Jetson image; clients wait this + 5 s
BACKEND_TIMEOUT_S=25

# --- Model and image size choice (API v1.2; empty = not offered) -------------
# Models a client may pick with context.model. The backend's own model
# (OLLAMA_MODEL / ECHO_MODEL) is always allowed and is the default.
# e.g. moondream,qwen3-vl:2b
ALLOWED_MODELS=
# Long-edge presets advertised in /v1/info; trailing * marks the recommended one
# (without *, the largest). The client resizes before upload.
# e.g. 448,672*,1024
IMAGE_SIZES=

# --- Echo backend (tests / QA) -----------------------------------------------
# ok | error | malformed | slow
ECHO_MODE=ok
# answer delay; reported as avg_latency_ms when > 0
ECHO_DELAY_MS=0
# name of echo's default model
ECHO_MODEL=echo
# simulated load time when switching models
ECHO_LOAD_MS=0
# empty = all ALLOWED_MODELS count as installed
ECHO_INSTALLED_MODELS=

# --- Ollama backend ----------------------------------------------------------
OLLAMA_URL=http://ollama:11434
# qwen2.5vl-jetson:3b in the Jetson image
OLLAMA_MODEL=moondream
OLLAMA_WARMUP=1
OLLAMA_QUEUE_SIZE=1
OLLAMA_RETRY_AFTER_S=5
OLLAMA_NUM_PREDICT=256
OLLAMA_TEMPERATURE=0
# -1 in the Jetson image
OLLAMA_KEEP_ALIVE=30m
OLLAMA_JSON_FORMAT=schema
OLLAMA_PLAIN_RETRY=1
OLLAMA_LOG_RAW=0
