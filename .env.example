# Example settings for apotheke-autofill-service. Copy what you need into your
# shell, .env.local or a docker --env-file; every variable is optional. Docs: README.md
# ("Configuration") and docs/api-v1.md.

# --- Service -----------------------------------------------------------------
# echo | ollama | cloudflare | clip
# Shipped default: Cloudflare primary, Ollama fallback.
BACKEND=cloudflare
# empty = no auth; set = Bearer token on all but /healthz
AUTOFILL_TOKEN=
# 10 MiB. This is the Python image cap. The Worker is separate:
# MAX_UPLOAD_BYTES defaults to 1048576, and /v1/info max_image_bytes is 983040.
MAX_IMAGE_BYTES=10485760
# Clients wait this + 5 s. Must be >= REQUEST_DEADLINE_S for the shipped pair.
BACKEND_TIMEOUT_S=45

# --- Model and image size choice (API v1.2; empty = not offered) -------------
# Models a client may pick with context.model. The backend's own model
# (OLLAMA_MODEL / ECHO_MODEL) is always allowed and is the default.
# e.g. moondream,qwen3-vl:2b
ALLOWED_MODELS=
# Long-edge presets advertised in /v1/info; trailing * marks the recommended one
# (without *, the largest). The client resizes before upload.
# e.g. 448,672*,1024
IMAGE_SIZES=

# --- Echo backend (tests / QA) -----------------------------------------------
# ok | error | malformed | slow
ECHO_MODE=ok
# answer delay; reported as avg_latency_ms when > 0
ECHO_DELAY_MS=0
# name of echo's default model
ECHO_MODEL=echo
# simulated load time when switching models
ECHO_LOAD_MS=0
# empty = all ALLOWED_MODELS count as installed
ECHO_INSTALLED_MODELS=
# raw brand / model_number / serial_number; json: prefix parses JSON (json:null)
ECHO_BRAND=
ECHO_MODEL_NUMBER=
ECHO_SERIAL_NUMBER=

# --- Ollama backend ----------------------------------------------------------
OLLAMA_URL=http://ollama:11434
# qwen2.5vl-jetson:3b in the Jetson image
OLLAMA_MODEL=moondream
OLLAMA_WARMUP=1
OLLAMA_QUEUE_SIZE=1
OLLAMA_RETRY_AFTER_S=5
OLLAMA_NUM_PREDICT=256
OLLAMA_TEMPERATURE=0
# -1 in the Jetson image
OLLAMA_KEEP_ALIVE=30m
OLLAMA_JSON_FORMAT=schema
OLLAMA_PLAIN_RETRY=1
OLLAMA_LOG_RAW=0

# --- Cloudflare Workers AI ---------------------------------------------------
# Docs: docs/cloudflare-backend.md. Placeholders only. Never commit a real token.
# none | ollama | cloudflare
# ollama fails over from Cloudflare and requires BACKEND=cloudflare.
# cloudflare fails over from Ollama and requires BACKEND=ollama.
# none with BACKEND=ollama is local-only and makes no Cloudflare call.
FALLBACK_BACKEND=ollama
FAILOVER_ON_COLD=false
CF_ACCOUNT_ID=
CF_API_TOKEN=
# Optional files. A direct value above wins. A missing file does not crash startup.
CF_ACCOUNT_ID_FILE=
CF_API_TOKEN_FILE=
CF_MODEL=@cf/google/gemma-4-26b-a4b-it
CF_TIMEOUT_S=20
# 6000 at 6.4 Neurons is about 930 Gemma 4 photos a day. 0 disables Cloudflare.
CF_DAILY_NEURON_BUDGET=6000
# Persistent volume, not /tmp. Jetson mounts /opt/autofill/data here.
CF_BUDGET_STATE_FILE=/var/lib/autofill/cf-neuron-budget.json
# Must be under Apotheke's 50 s client timeout, and <= BACKEND_TIMEOUT_S,
# when BACKEND=cloudflare and FALLBACK_BACKEND=ollama.
REQUEST_DEADLINE_S=45
# Warm Jetson p95 at 560 px is about 11 s. Cold Qwen on the board is 25-32 s.
OLLAMA_WARM_RESERVE_S=15
OLLAMA_COLD_RESERVE_S=35
# The assignments above are the shipped pair.
# Effective slice = min(CF_TIMEOUT_S, REQUEST_DEADLINE_S - reserve - repair).
# Repair allowance is 0 with these defaults (a second 20 s call does not fit).
# Warm: min(20, 45 - 15 - 0) = 20.  20 + 15 = 35, under 45 and under 50.
# Cold: min(20, 45 - 35 - 0) = 10.  10 + 35 = 45, under the 50 s client timeout.
# Ollama-only, no egress:
# BACKEND=ollama
# FALLBACK_BACKEND=none
