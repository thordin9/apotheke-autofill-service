# /opt/autofill/service.env on the Jetson: root:root, mode 600. Read by `docker run --env-file`.
# Docker env files take values literally: no quotes, no `export`, no inline comments.
BACKEND=ollama
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5vl-jetson:3b
# 1 logs every raw model answer (photo descriptions) in the container log; leave it off in production.
OLLAMA_LOG_RAW=0
# Generate it without printing it (see docs/deploy-jetson.md, "service.env"). Never commit the real value.
AUTOFILL_TOKEN=<generate-a-random-token>
OLLAMA_KEEP_ALIVE=-1
BACKEND_TIMEOUT_S=45
# Model and image size choice (API v1.2). IMAGE_SIZES: comma-separated long edges (64-8192); one '*' marks the
#   recommended size (two is a startup error); without a '*' the largest is recommended. 560 px: same accuracy as
#   1024 px in about 60% of the time (docs/benchmarks.md).
IMAGE_SIZES=448,560*,1024
# ALLOWED_MODELS: comma-separated tags clients may pick (OLLAMA_MODEL is always the default and always allowed).
#   On the Jetson, list only the default: that just turns on /v1/info "models" (Apotheke v2.4's dropdown) with no
#   model switches. Never list qwen3-vl:2b (installed, but can't load there). See docs/deploy-jetson.md.
ALLOWED_MODELS=qwen2.5vl-jetson:3b
# Cloudflare stays off in this file. Opt-in is docs/cloudflare-backend.md.
# The neuron counter, if you enable it later, is a file under /var/lib/autofill
# (host directory /opt/autofill/data, mounted by run-service.sh). Not /tmp.
