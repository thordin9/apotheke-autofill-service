# /opt/autofill/service.env on the Jetson: root:root, mode 600. Read by `docker run --env-file`.
# Docker env files take values literally: no quotes, no `export`, no inline comments.
BACKEND=ollama
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5vl-jetson:3b
# 1 logs every raw model answer (photo descriptions) in the container log; leave it off in production.
OLLAMA_LOG_RAW=0
# Generate it without printing it (see docs/deploy-jetson.md, "service.env"). Never commit the real value.
AUTOFILL_TOKEN=<generate-a-random-token>
OLLAMA_KEEP_ALIVE=-1
BACKEND_TIMEOUT_S=45
# Feature 7 (pending, PR #10). Both are optional; when they're unset, /v1/info is unchanged.
# ALLOWED_MODELS: comma-separated EXTRA tags. OLLAMA_MODEL is always the default and always allowed;
#   tags not installed in Ollama are hidden from /v1/info. IMAGE_SIZES: comma-separated long edges (64-8192),
#   one '*' marks the recommended size (two is a startup error). Production values: set to ITAdvisor's recommended picks at deploy.
# ALLOWED_MODELS=<extra-model-tags>
# IMAGE_SIZES=448,672*,1024
