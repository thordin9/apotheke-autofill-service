# /etc/systemd/system/dl-cap-check.timer
# Runs dl-cap-check.service 2 min after boot, then every 5 min. Enable with: systemctl enable --now dl-cap-check.timer
[Unit]
Description=Re-check the 30 Mbit/s inbound cap on eth0 every 5 minutes

[Timer]
OnBootSec=2min
OnUnitActiveSec=5min
AccuracySec=30s

[Install]
WantedBy=timers.target
