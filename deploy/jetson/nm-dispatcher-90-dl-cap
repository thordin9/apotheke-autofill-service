#!/bin/sh
# NetworkManager dispatcher hook: reapply the 30 Mbit/s inbound cap (dl-cap.service) when NetworkManager brings
# the capped interface up or may have reset it. At boot, dl-cap.service can run before NetworkManager takes over
# eth0; NetworkManager then resets the device and the ingress qdisc (and with it the cap) is silently gone.
# Install: install -o root -g root -m 755 nm-dispatcher-90-dl-cap /etc/NetworkManager/dispatcher.d/90-dl-cap
# NetworkManager calls it as: 90-dl-cap <interface> <action>. It always exits 0 so it never disturbs NetworkManager.
#   eth0 up                  restart dl-cap.service (the device was just (re)configured; the qdisc may be gone)
#   eth0 dhcp4-change        `dl-cap.sh check` first; restart only if the cap is missing. A lease renewal doesn't
#                            reset the qdisc, and a needless restart leaves a short uncapped gap and counts toward
#                            dl-cap.service's start limit (10 per 5 min).
#   "" connectivity-change   same check-then-restart. NetworkManager sends this event with an empty interface.
#   anything else            ignored
DEV=eth0   # must match DEV in dl-cap.sh
DL_CAP=/usr/local/sbin/dl-cap.sh   # the harness rewrites this line to point at the repo copy

case "${1:-}:${2:-}" in
  "$DEV:up") mode=restart ;;
  "$DEV:dhcp4-change"|":connectivity-change"|"$DEV:connectivity-change") mode=check ;;
  *) exit 0 ;;
esac
# Respect `systemctl disable dl-cap`: a disabled cap stays off. (`systemctl stop` alone is undone on the next event.)
systemctl is-enabled --quiet dl-cap.service 2>/dev/null || exit 0
if [ "$mode" = check ] && [ -x "$DL_CAP" ] && DEV=$DEV "$DL_CAP" check >/dev/null 2>&1; then
  exit 0   # cap in place: nothing to do
fi
# --no-block: queue the restart and return, so the dispatcher isn't held up; dl-cap.service is ordered after
# network-online.target, which may still be pending while NetworkManager is activating eth0.
systemctl --no-block restart dl-cap.service || true
exit 0
