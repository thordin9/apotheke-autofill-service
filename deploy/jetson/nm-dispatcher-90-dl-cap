#!/bin/sh
# NetworkManager dispatcher hook: reapply the 30 Mbit/s inbound cap (dl-cap.service) when NetworkManager brings
# the capped interface up or changes it. At boot, dl-cap.service can run before NetworkManager takes over eth0;
# NetworkManager then resets the device and the ingress qdisc (and with it the cap) is silently gone.
# Install: install -o root -g root -m 755 nm-dispatcher-90-dl-cap /etc/NetworkManager/dispatcher.d/90-dl-cap
# NetworkManager calls it as: 90-dl-cap <interface> <action>. It always exits 0 so it never disturbs NetworkManager.
DEV=eth0   # must match DEV in dl-cap.sh
[ "${1:-}" = "$DEV" ] || exit 0
case "${2:-}" in
  up|connectivity-change|dhcp4-change) ;;
  *) exit 0 ;;
esac
# Respect `systemctl disable dl-cap`: a disabled cap stays off. (`systemctl stop` alone is undone on the next event.)
systemctl is-enabled --quiet dl-cap.service 2>/dev/null || exit 0
# --no-block: queue the restart and return, so the dispatcher isn't held up; dl-cap.service is ordered after
# network-online.target, which may still be pending while NetworkManager is activating eth0.
systemctl --no-block restart dl-cap.service || true
exit 0
